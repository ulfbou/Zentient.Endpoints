<!-- Zentient Endpoints Core Project File -->
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Analyzer test projects should usually target the same netstandard as the analyzer -->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>

		<RootNamespace>Zentient.Endpoints</RootNamespace>
		<IsPackable>true</IsPackable>
		<Description>Core abstractions and utilities for unifying result handling across transport protocols (HTTP, gRPC, Messaging) using Zentient.Results.</Description>
		<AssemblyOriginatorKeyFile>..\..\Zentient.snk</AssemblyOriginatorKeyFile>
		<PackageId>Zentient.Endpoints</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Zentient.Endpoints.Http.Tests.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--<ProjectReference Include="..\Zentient.Results\Src\Results\Zentient.Results.csproj" />-->
		<PackageReference Include="FluentAssertions" Version="8.4.0" />
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="System.Collections.Immutable" Version="9.0.6" />
		<PackageReference Include="Zentient.Results" Version="0.4.4" />
	</ItemGroup>

</Project>
